{
  "Entries": {
    "function/\"libertas_building_climate\"/\"building\"/property/\"Description\"": {
      "Current": "sha256:afa4c54492325c19126d251efb0caac3e2e716e4d1d64a598ff59719c32121b6",
      "Target": "首先添加房间，然后添加恒温器并选择每个房间服务的房间。每个房间至少需要一个温度传感器，并且必须恰好分配给一个恒温器。湿度和空气质量传感器是可选的。还要选择至少一个人来接收重要警告。"
    },
    "function/\"libertas_building_climate\"/\"building\"/property/\"Name\"": {
      "Current": "sha256:b34d19a0fe90cd6a7d3f515c3cabf33dae9651479ef9b6894277f27b2b928c4a",
      "Target": "建筑"
    },
    "function/\"libertas_building_climate\"/\"external_features\"/property/\"Description\"": {
      "Current": "sha256:19a29eb5389c45c2f03f3eb524b9ee4cef314dec35ea90f37601783de432fef2",
      "Target": "您可以选择提供能源价格、占用率、窗口状态、仪表、日历信息或中央设备数据的服务。当该信息不可用时，请将此留空。"
    },
    "function/\"libertas_building_climate\"/\"external_features\"/property/\"Name\"": {
      "Current": "sha256:e895f70ed11da3ec125c29c49093210542d07fbc9004ea900dfa3e12d3eec5b3",
      "Target": "附加建筑信息"
    },
    "function/\"libertas_building_climate\"/\"external_features\"/property/\"NullText\"": {
      "Current": "sha256:1fe1d3228b195bb8932f61c5ec9bfdf78680e06261f1c281e295ffa9675ecbfc",
      "Target": "不使用额外的楼宇信息"
    },
    "function/\"libertas_building_climate\"/\"external_features\"/property/\"SetText\"": {
      "Current": "sha256:1a3db283b1f4c96c95a473a20265197111256c81c5f9516079573ef8a2f19d39",
      "Target": "使用服务："
    },
    "function/\"libertas_building_climate\"/\"weather\"/property/\"Description\"": {
      "Current": "sha256:3e800c7108df999a291d280775918ee224505236a38f9329b1f0c883ce07122a",
      "Target": "选择用于帮助规划供暖和制冷的当地气象服务。"
    },
    "function/\"libertas_building_climate\"/\"weather\"/property/\"Name\"": {
      "Current": "sha256:65ff4fdf06a667f40e1e6303eaf0ab4ecd2d18418e1ec0c4255f76709026953d",
      "Target": "天气服务"
    },
    "function/\"libertas_building_climate\"/property/\"DefaultText\"": {
      "Current": "sha256:6d9a9fa3050df28034ab3f94413f555866ed23cfc4a9cb63be5c90288babb813",
      "Target": "智能建筑气候"
    },
    "function/\"libertas_building_climate\"/property/\"Description\"": {
      "Current": "sha256:26439f526e74c4f98f139cd5d34928c09b6692b6bd8d40baf11928884af84ad4",
      "Target": "保持每个房间的舒适度，同时平衡可能为多个房间提供服务的恒温器的舒适度和能源使用。用户为房间命名，分配其恒温器和室内传感器，选择性地选择室外传感器，并选择当地天气、附加建筑信息和要通知的人员。用户可以选择每个房间的供暖和制冷模式、首选温度范围以及舒适与节省之间的平衡。气候控制器将当前传感器读数和天气与可用的能源价格、占用率、窗口、日历、仪表和中央设备信息相结合。气候控制器自动学习房间如何响应，协调共享恒温器，调整有限的加热和冷却设定点，并计算即将到来的房间计划。气候控制器显示室内和室外条件、空气质量、传感器可用性、加热或冷却活动、有效设定点、舒适度统计数据、学习行为和即将到来的计划。气候控制器向选定的人员发送关于冰冻风险、过热、无法控制或无效加热和冷却的警告、提醒和恢复消息；这些不是生命安全警报。"
    },
    "function/\"libertas_building_climate\"/property/\"DisplayName\"": {
      "Current": "sha256:7633b57ffbe203510f5e4cf7d18680a581da50210808db37f7839592cc32c686",
      "Target": "智能建筑气候"
    }
  },
