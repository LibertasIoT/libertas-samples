    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Description\"": {
      "Current": "sha256:a169f1f32d082b8cf003ebde9b8607824004f1e15e7bc14db798e742d45a64ef",
      "Target": "निरूपित अवलोकन समय पर खगोलीय क्षितिज से ऊपर डिग्री में सूर्य के केंद्र की ज्यामितीय ऊंचाई। नकारात्मक मान सूर्य को क्षितिज के नीचे रखते हैं। इस मान की गणना करने के लिए निर्माण स्थल के निर्देशांक के साथ मौजूदा रिकॉर्ड के `valid_at` या मौजूदा इतिहास या पूर्वानुमान अवधि के मध्यबिंदु का उपयोग करें।"
    },
