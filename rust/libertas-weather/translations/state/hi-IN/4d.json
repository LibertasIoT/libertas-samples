    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:64fb9174f521732f3f13caed281655f8f5fc6e5443cbbecd66e9aba490e53a80",
      "Target": "वास्तविक उत्तर से दक्षिणावर्त दिशा में सूर्य के केंद्र की दिशा उसी अवलोकन समय को दर्शाती है। HVAC मशीन-लर्निंग उपभोक्ता कच्चे डिग्री मान को क्रमिक के रूप में व्याख्या करने के बजाय इस चक्रीय कोण को साइन और कोसाइन में परिवर्तित करते हैं।"
    },
