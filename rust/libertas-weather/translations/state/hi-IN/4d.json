    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_direction_degrees\"/property/\"Description\"": {
      "Current": "sha256:ebe8696cc9e3d1ad96a9bf91a898ab6841b8ee9d034031d2c152a61be7083d0a",
      "Target": "वह दिशा जहां से हवा वास्तविक उत्तर से दक्षिणावर्त डिग्री में उत्पन्न होती है। शून्य और 360 दोनों उत्तर दिशा का प्रतिनिधित्व करते हैं। दिशा तभी उपयोगी होती है जब भवन मॉडल अग्रभाग अभिविन्यास जानता हो।"
    },
