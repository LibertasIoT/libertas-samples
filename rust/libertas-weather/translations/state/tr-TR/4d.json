    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_direction_degrees\"/property/\"Description\"": {
      "Current": "sha256:04da9f2c3356459efa71545da0f5b60e44ee3df77a39b21b80cc91727a028d8a",
      "Target": "Rüzgârın gerçek kuzeyden derece cinsinden saat yönünde geldiği yön. Sıfır ve 360 ​​derecenin her ikisi de kuzeyi temsil eder. Yön yalnızca bina modeli cephe yönelimini bildiğinde kullanışlıdır."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_direction_degrees\"/property/\"Name\"": {
