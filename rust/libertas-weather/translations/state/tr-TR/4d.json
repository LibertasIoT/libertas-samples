    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"relative_humidity_percent\"/property/\"Description\"": {
      "Current": "sha256:f52ecad6549fe956c0edce2d55acfcf2555550ce5897bbc78456030f9b7aa919",
      "Target": "0'dan 100'e kadar tam sayı yüzdesi olarak yerden iki metre yükseklikte dış mekan bağıl nemi. Bu sağlayıcı değeri görüntüleme ve doğrulamayı destekler; psikrometrik hesaplamalar, birbiriyle çelişen gereksiz değerleri karıştırmak yerine tutarlı bir girdi seti kullanmalıdır."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"relative_humidity_percent\"/property/\"Name\"": {
