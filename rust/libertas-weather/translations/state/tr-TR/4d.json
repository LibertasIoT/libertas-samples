    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:129d5e5cdffa8c4330b387e7f9b98e0711b42e7eb3eca33548a6ffcc536bbcb1",
      "Target": "Aynı temsil edilen gözlem zamanında güneşin merkezinin gerçek kuzeyden saat yönünde derece cinsinden yönü. HVAC makine öğrenimi tüketicileri, ham derece değerini sıralı olarak yorumlamak yerine bu döngüsel açıyı sinüs ve kosinüse dönüştürür."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Name\"": {
