    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_gust_meters_per_second\"/property/\"Description\"": {
      "Current": "sha256:f4c564e473f2d55d9b5381e1ef9785a18b0e738f8340610235744c3d7fb2e9e2",
      "Target": "Açık hava rüzgârının yerden 10 metre yükseklikte, saniyede metre cinsinden zirve değeri. Açıkta kalan damperlerin ve ekipmanların muhafazakar kontrolünü destekler."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_gust_meters_per_second\"/property/\"Name\"": {
      "Current": "sha256:b96582eecf580f35fe8973ac7306c3200aa71a93d987dc2456850dc473b87294",
