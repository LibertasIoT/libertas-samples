    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_speed_meters_per_second\"/property/\"Description\"": {
      "Current": "sha256:9e29d2b9edf43ad3d51dd7370c41416b24441fd53820c121cb7ad43eac4c0659",
      "Target": "Yerden 10 metre yükseklikte saniyede metre cinsinden sürekli dış rüzgar hızı. Bir bina modeli, sızıntıyı ve basınca bağlı dış hava yüklerini tahmin etmek için bunu kullanabilir."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_speed_meters_per_second\"/property/\"Name\"": {
