    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:580805075c18083dbdd9b64c1e4adcab7da342b54bfc2a89620c25fa60974a1e",
      "Target": "Richting van het centrum van de zon in graden met de klok mee vanaf het ware noorden op hetzelfde weergegeven observatietijdstip. HVAC consumenten die machine learning gebruiken, converteren deze cyclische hoek naar sinus en cosinus in plaats van de ruwe graadwaarde als ordinaal te interpreteren."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Name\"": {
