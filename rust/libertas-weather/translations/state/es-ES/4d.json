    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"surface_pressure_hectopascals\"/property/\"Description\"": {
      "Current": "sha256:60052eab0fca8f29129870660db6b6d754c700b4d9b60dccd8975573f403b664",
      "Target": "Presión atmosférica a la altura del edificio en hectopascales. Para los cálculos psicrométricos se utiliza la presión superficial, en lugar de la presión reducida al nivel del mar."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"surface_pressure_hectopascals\"/property/\"Name\"": {
      "Current": "sha256:68d3fdb58cad111908cadd31eb231f879e6ba4253963f3b8415521a21ecc7559",
