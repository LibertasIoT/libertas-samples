    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_direction_degrees\"/property/\"Description\"": {
      "Current": "sha256:012e5efd73d6b738ead605f6ab7e041379c65855d148b76858ce89f384c2580b",
      "Target": "Dirección desde la que se origina el viento en grados en el sentido de las agujas del reloj desde el norte verdadero. Cero y 360 representan el norte. La dirección sólo es útil cuando el modelo de construcción conoce la orientación de la fachada."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_direction_degrees\"/property/\"Name\"": {
