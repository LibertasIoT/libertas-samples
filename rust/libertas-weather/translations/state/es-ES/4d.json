    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"relative_humidity_percent\"/property/\"Description\"": {
      "Current": "sha256:7ba68797d6209186c98072c8234c7d04245dbad48d84d9b92445638bec2a2709",
      "Target": "Humedad relativa exterior a dos metros sobre el suelo como porcentaje entero de 0 a 100. Este valor del proveedor admite visualización y validación; Los cálculos psicrométricos deben utilizar un conjunto de entradas coherente en lugar de mezclar valores redundantes y discrepantes."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"relative_humidity_percent\"/property/\"Name\"": {
