    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:326b0ac40670057c3d9c89d173584278ad4bbfe7ae36632e705c803973eb719d",
      "Target": "Dirección del centro del sol en grados en el sentido de las agujas del reloj desde el norte verdadero en el mismo momento de observación representado. HVAC los consumidores de aprendizaje automático convierten este ángulo cíclico en seno y coseno en lugar de interpretar el valor de grado bruto como ordinal."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Name\"": {
