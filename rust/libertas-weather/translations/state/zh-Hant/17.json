    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherIncrementV1\"/property/\"Description\"": {
      "Current": "sha256:8b4130993b202c90cf62112dc0a71eca6ba3050bbd4104182b0cb3aa60ada6d0",
      "Target": "僅回報成功天氣要求後的狀態變更。游標不符或範圍不連續時，需要再次提出訂閱要求；用戶端不得只套用部分報告。有效的報告或 PeerAlive 會重新啟動復原回應的等待計時器；PeerAlive 絕不會進入此資料結構描述，也不會變更游標。"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherIncrementV1\"/property/\"Name\"": {
