      "Target": "最長等待間隔"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherRecoveryV1\"/\"recovery\"/property/\"Description\"": {
      "Current": "sha256:03dea5e093cf68b62339301cf5e38971fa8847e392fdea707e32b8a26315c38e",
      "Target": "繼續要求的重播、重設或錯誤結果。"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherRecoveryV1\"/\"recovery\"/property/\"Name\"": {
      "Current": "sha256:04ae548e9a46d54a7f9c5daa61a7afc34f16fe16d8f7c2bb642f05929cecae3f",
      "Target": "復原"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherRecoveryV1\"/property/\"Description\"": {
      "Current": "sha256:7603422b5c58ba114f7c2fede48ea2f5ba584c6800ce602fe6d3e17f4f002b19",
      "Target": "使用重播的變更、重設快照或可復原錯誤來回應天氣要求。每個回應都會提供最長等待間隔。訂閱用戶端會在成功重播或重設後使用該間隔；一次性用戶端則會忽略它。發生錯誤後，以復原錯誤及重試延遲為優先。"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherRecoveryV1\"/property/\"Name\"": {
      "Current": "sha256:169895a4e0b4c1f2215f9153c0e63c786cb6d12f7d611425a7c52522808a2bcf",
      "Target": "灑水器天氣復原"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/property/\"Description\"": {
      "Current": "sha256:6f06613ae01a4b08addf6197ed12456d9b5cbe5a35b4aaa5167ff6a3017ee86b",
      "Target": "定義用於要求或訂閱灑水器天氣的具型別 Libertas 端點交易。回應會公開可各自獨立使用的歷史、目前及預報區段，因此服務中斷不會隱藏可用的快取資料。Libertas 端點狀態合約會拒絕格式錯誤的 Avro，以及用於錯誤訊息角色的值；這些傳輸錯誤不是復原變體。"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/property/\"Name\"": {
      "Current": "sha256:f640970608b438eb5b13c63b2793eb781f6e388aa428eda70a7afcd1ac4282a8",
      "Target": "灑水器天氣通訊協定"
    },
