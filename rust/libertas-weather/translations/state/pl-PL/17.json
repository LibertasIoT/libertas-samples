    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"GetWeatherV1\"/\"include_current\"/property/\"Description\"": {
      "Current": "sha256:afa2ff8d31ed0f9b33468cced35a67b304d836da9a173bb46ce60e71d1037739",
      "Target": "Określa, czy migawka resetowania powinna zawierać bieżące warunki z pamięci podręcznej."
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"GetWeatherV1\"/\"include_current\"/property/\"Name\"": {
