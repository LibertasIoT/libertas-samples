    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"dew_point_temperature_celsius\"/property/\"Description\"": {
      "Current": "sha256:76edd374bd9bfc51e2db863affcff61d9f4157f3fc082d4ec1a3fe5c5b9def5b",
      "Target": "Zewnętrzna temperatura punktu rosy na wysokości dwóch metrów nad poziomem gruntu w stopniach Celsjusza. Razem z ciśnieniem, umożliwia to obliczenia współczynnika wilgotności, entalpii, termometru mokrego, ryzyka kondensacji i obciążenia utajonego."
    },
