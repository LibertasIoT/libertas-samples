      "Target": "Rozproszone natężenie promieniowania poziomego"
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"direct_normal_irradiance_watts_per_square_meter\"/property/\"Description\"": {
      "Current": "sha256:f74a80127d43cae9f5f0ccab0d18fdaa59e42fedd07c0d247309ca3cf0976cea",
      "Target": "Bezpośrednia energia słoneczna padająca na powierzchnię normalną do światła słonecznego, wyrażona w watach na metr kwadratowy. Z tej wartości mogą korzystać modele zorientowanych elewacji i cieniowania."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"direct_normal_irradiance_watts_per_square_meter\"/property/\"Name\"": {
