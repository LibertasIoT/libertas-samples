    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:dba5ef5e1fb5b76a951deb0f2fab87edbfa85150c81e0252f6fd3fdd13b089e5",
      "Target": "Direction du centre du soleil en degrés dans le sens des aiguilles d'une montre à partir du nord vrai à la même heure d'observation représentée. Les consommateurs d'apprentissage automatique HVAC convertissent cet angle cyclique en sinus et cosinus au lieu d'interpréter la valeur brute du degré comme ordinale."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Name\"": {
