    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Description\"": {
      "Current": "sha256:a59b020d2d5aadf9d29173a15fa4cfdf7a98b20a76941c9cf5a6ec5de8ef0e38",
      "Target": "Élévation géométrique du centre du soleil en degrés au-dessus de l'horizon astronomique à l'heure d'observation représentée. Les valeurs négatives placent le soleil sous l'horizon. Utilisez le `valid_at` de l'enregistrement actuel contenant ou le point médian d'un historique ou d'une période de prévision contenant ainsi que les coordonnées du chantier pour calculer cette valeur."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Name\"": {
