      "Current": "sha256:247de252324a770965db6ec0e0b25da6039d6b2e0c714366c37f16f27fb15038",
      "Target": "Pression atmosphérique à l'altitude du bâtiment en hectopascals. La pression de surface, plutôt que la pression réduite au niveau de la mer, est utilisée pour les calculs psychrométriques."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"surface_pressure_hectopascals\"/property/\"Name\"": {
