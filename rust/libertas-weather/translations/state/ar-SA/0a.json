    },
    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherRecoveryV1\"/\"recovery\"/property/\"Description\"": {
      "Current": "sha256:c92f331c4772624bbb52cada58831c028e592cd92047e84dea471a2963eacf97",
      "Target": "إعادة التشغيل أو إعادة تعيين اللقطة أو نتيجة الخطأ المكتوب."
    },
    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherRecoveryV1\"/\"recovery\"/property/\"Name\"": {
