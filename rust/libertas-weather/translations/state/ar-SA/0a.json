    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"GetBuildingHvacWeatherV1\"/property/\"Description\"": {
      "Current": "sha256:25259f51f489840cb1f86b2c8ec11e60be90f2d19c7afbf98a978c3ea74e2cfa",
      "Target": "إجراء قراءة تزايدية لمرة واحدة أو بدء الاشتراك أو استئنافه. يقوم الخادم بإعادة عرض التغييرات التي تم الاحتفاظ بها بعد `after_cursor` عندما يكون ذلك ممكنًا أو يقوم بإرجاع الأقسام المخزنة مؤقتًا بشكل مستقل والمقيدة بالنطاقات الاحتياطية المطلوبة."
    },
    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"GetBuildingHvacWeatherV1\"/property/\"Name\"": {
