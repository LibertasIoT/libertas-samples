    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherRecoveryV1\"/\"maximum_wait_interval_seconds\"/property/\"Description\"": {
      "Current": "sha256:4ee937b399321a2e85de09795dfbc799b90cee58601415b3162a9bdf2aef0998",
      "Target": "الحد الأقصى للثواني التي ينتظرها عميل الاشتراك قبل إعادة المحاولة باستخدام المؤشر الأخير. يرسل الخادم البيانات المتغيرة أو PeerAlive أولاً. يتجاهل عميل اللقطة الواحدة هذه القيمة المطلوبة غير الصفرية."
    },
    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherRecoveryV1\"/\"maximum_wait_interval_seconds\"/property/\"Name\"": {
