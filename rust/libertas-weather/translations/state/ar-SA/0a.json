    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/property/\"Description\"": {
      "Current": "sha256:8898fb0a1039b601701624690a83652e123a5be162d319f40dd14f0bade605f6",
      "Target": "يحدد معاملات الطلب لمرة واحدة والاشتراك الخاصة بطقس نظام التدفئة والتهوية وتكييف الهواء للمنزل بأكمله أو المبنى بأكمله. تحدد عملية نقطة نهاية Libertas سلوك الطلب لمرة واحدة أو الاشتراك، وليس أي حقل في عقد الرسائل العام هذا."
    },
