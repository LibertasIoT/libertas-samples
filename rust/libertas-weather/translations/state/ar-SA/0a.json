    },
    "type/\"\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherProtocol\"/\"BuildingHvacWeatherRecoveryV1\"/property/\"Description\"": {
      "Current": "sha256:119fdf0cf9ab765106cf12773c189068f21c84790e2c07f3668ef15386e776d2",
      "Target": "يستجيب لكل طلب الحصول على صالح مع إعادة التشغيل، أو لقطة إعادة تعيين، أو خطأ مكتوب. يقوم عملاء الاشتراك بإعادة تشغيل المهلة الخاصة بهم بعد الاسترداد الناجح وتقارير البيانات اللاحقة وPeerAlive."
    },
