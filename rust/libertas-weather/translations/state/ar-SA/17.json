    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherIncrementV1\"/\"report\"/property/\"Name\"": {
      "Current": "sha256:73b4f1577e346d134f3d7955babdd168dace26c9a18b0f4366645dc252ea4fe6",
      "Target": "التقرير التزايدي"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherIncrementV1\"/property/\"Description\"": {
      "Current": "sha256:bbbe364c357963249af1e3f8ff2ac0be2099b688ae942ce73aca9c71870ed7ed",
      "Target": "يبلغ فقط عن تغييرات الحالة بعد نجاح طلب الطقس. يتطلب عدم تطابق المؤشر أو وجود نطاق غير متصل طلب اشتراك آخر؛ ويجب ألا يطبّق العميل التقرير جزئيًا. يعيد تقرير صالح أو PeerAlive تشغيل مؤقت انتظار استجابة الاسترداد؛ ولا يدخل PeerAlive مطلقًا في مخطط البيانات هذا ولا يغيّر المؤشر."
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherIncrementV1\"/property/\"Name\"": {
      "Current": "sha256:74399ecea54c5d7501f709cc09d617acb9a7a6cab983098080fa0ec582ebac13",
      "Target": "تغيير طقس مرشّات الري"
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherRecoveryV1\"/\"maximum_wait_interval_seconds\"/property/\"Description\"": {
      "Current": "sha256:8f7985f2c289e2fba9391189180b6477fd7768c9964f6df3e22a33da8218d525",
      "Target": "الحد الأقصى لعدد الثواني التي ينتظرها عميل الاشتراك بعد نجاح الاسترداد أو التقرير التزايدي أو PeerAlive. يرسل الخادم البيانات المتغيرة أو PeerAlive أولًا. ويتجاهل عملاء الطلب لمرة واحدة هذه القيمة الإلزامية غير الصفرية."
    },
    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"WeatherRecoveryV1\"/\"maximum_wait_interval_seconds\"/property/\"Name\"": {
