    "type/\"\"/\"SprinklerWeatherProtocol\"/\"SprinklerWeatherProtocol\"/\"GetWeatherV1\"/property/\"Description\"": {
      "Current": "sha256:47f658943f5381514b448a8e4db3ba4441f9f315f1dca4f09fbe5850f84681f2",
      "Target": "ينفّذ قراءة تزايدية لمرة واحدة أو يبدأ اشتراكًا تزايديًا أو يستأنفه. تحدد عملية نقطة نهاية Libertas السلوك؛ فهو غير مرمّز في هذه الرسالة. يعيد الخادم تشغيل التغييرات المحتفظ بها بعد `after_cursor` متى أمكن، أو يعيد لقطة مخزنة مؤقتًا ومحدودة بنطاق."
    },
