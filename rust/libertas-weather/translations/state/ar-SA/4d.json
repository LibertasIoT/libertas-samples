    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_speed_meters_per_second\"/property/\"Description\"": {
      "Current": "sha256:a81c4f5e3715291f46c84bec22e6d74be737b3afee93ca0a97836463217df15c",
      "Target": "سرعة الرياح الخارجية المستمرة على ارتفاع 10 أمتار فوق سطح الأرض بالمتر في الثانية. قد يستخدمه نموذج البناء لتقدير التسلل وأحمال الهواء الخارجي المدفوعة بالضغط."
    },
