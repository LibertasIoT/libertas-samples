      "Target": "الضغط السطحي"
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"wind_direction_degrees\"/property/\"Description\"": {
      "Current": "sha256:b3cafee26583ff87c70bab7e56e59e9f1368a669af415922179dd226f573e320",
      "Target": "الاتجاه الذي تنطلق منه الرياح بالدرجات في اتجاه عقارب الساعة من الشمال الحقيقي. صفر و360 كلاهما يمثلان الشمال. يكون الاتجاه مفيدًا فقط عندما يعرف نموذج المبنى اتجاه الواجهة."
    },
