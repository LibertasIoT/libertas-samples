    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"relative_humidity_percent\"/property/\"Description\"": {
      "Current": "sha256:5514364d185c908dcc76bb1dcddb1be863fe9709db173e1702a9b32c6b700bbe",
      "Target": "الرطوبة النسبية الخارجية على ارتفاع مترين فوق سطح الأرض كنسبة مئوية صحيحة من 0 إلى 100. تدعم قيمة الموفر هذه العرض والتحقق من الصحة؛ يجب أن تستخدم الحسابات النفسية مجموعة مدخلات واحدة متسقة بدلاً من خلط القيم الزائدة عن الحاجة."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"relative_humidity_percent\"/property/\"Name\"": {
      "Current": "sha256:edd3e7b5aef861f6b76760dc542aa8792896af1855fa1611dedddd8bae118d76",
      "Target": "الرطوبة النسبية"
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:d428089330435579cefebf9929b986d26f20b84eff7e0a21ce96ff9624133184",
      "Target": "اتجاه مركز الشمس بالدرجات في اتجاه عقارب الساعة من الشمال الحقيقي في نفس وقت المراقبة الممثل. HVAC يقوم مستهلكو التعلم الآلي بتحويل هذه الزاوية الدورية إلى جيب وجيب التمام بدلاً من تفسير قيمة الدرجة الأولية على أنها ترتيبية."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Name\"": {
      "Current": "sha256:80a99daf39589f31c44f7a6cd1421ac37dc2357bf34ea266d4275f91052c966e",
      "Target": "السمت الشمسي"
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Description\"": {
      "Current": "sha256:33268fa45aa2f1207d2d45166a4bd4e4fb902852b53d6c66db57e6f5822c619e",
      "Target": "الارتفاع الهندسي لمركز الشمس بالدرجات فوق الأفق الفلكي في وقت الرصد الممثل. القيم السلبية تضع الشمس تحت الأفق. استخدم `valid_at` السجل الحالي المحتوي عليه أو نقطة المنتصف للسجل المحتوي أو فترة التنبؤ مع إحداثيات موقع البناء لحساب هذه القيمة."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Name\"": {
      "Current": "sha256:bedfd395b3e01fe8c02f28c0bf879ebb8f07c98de79a7c7ea9aed48fc198fe57",
      "Target": "الارتفاع الشمسي"
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"surface_pressure_hectopascals\"/property/\"Description\"": {
      "Current": "sha256:4ec8e7214063dac665bc482c6fa37e50a83b3a4b38c447ac910e3d8dd92b5494",
      "Target": "الضغط الجوي عند ارتفاع المبنى بالهكتوباسكال. يُستخدم الضغط السطحي، بدلاً من الضغط المخفض إلى مستوى سطح البحر، في الحسابات السيكرومترية."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"surface_pressure_hectopascals\"/property/\"Name\"": {
