    "type/\"\"/\"SprinklerWeatherPersistentData\"/\"SprinklerWeatherPersistentData\"/property/\"Description\"": {
      "Current": "sha256:77c22c582e738474523e39fb07725b45ee503288a82818d51ce916163df98c3c",
      "Target": "يحدد المجموعة الكاملة من القيم التي يجوز لوكيل طقس مرشّات الري كتابتها في قاعدة بيانات Libertas. بيانات تعريف السجل التاريخي والظروف الحالية والتوقعات والموقع سجلات مفردة مستقلة. وكل فترة تاريخية مكتملة هي سجل مفهرس مفتاحه الطابع الزمني لبدئها. وقد استُبعدت مؤشرات الاشتراك وسجلات إعادة التشغيل عمدًا: إذ يجب ألا تؤدي إعادة تعيينها إلى محو هذه السجلات."
    },
