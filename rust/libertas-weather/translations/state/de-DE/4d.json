    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Description\"": {
      "Current": "sha256:1581efe53fd29f17f339f653a773b46235debee00f359b2549668ad23c415cde",
      "Target": "Geometrische Höhe des Sonnenmittelpunkts in Grad über dem astronomischen Horizont zum dargestellten Beobachtungszeitpunkt. Bei negativen Werten liegt die Sonne unter dem Horizont. Verwenden Sie zur Berechnung dieses Werts den `valid_at` des enthaltenden aktuellen Datensatzes oder den Mittelpunkt eines enthaltenden Verlaufs- oder Prognosezeitraums zusammen mit den Baustellenkoordinaten."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_elevation_degrees\"/property/\"Name\"": {
