    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Description\"": {
      "Current": "sha256:ff1ad878510effd6b606cbe9732199b83b78d200dc0079835ce58bede0d907f3",
      "Target": "Richtung des Sonnenmittelpunkts in Grad im Uhrzeigersinn vom wahren Norden zur gleichen dargestellten Beobachtungszeit. HVAC Machine-Learning-Konsumenten konvertieren diesen zyklischen Winkel in Sinus und Cosinus, anstatt den rohen Gradwert als Ordinalzahl zu interpretieren."
    },
    "type/\"\"/\"BuildingHvacOutdoorConditionsV1\"/\"BuildingHvacOutdoorConditionsV1\"/\"solar_azimuth_degrees\"/property/\"Name\"": {
