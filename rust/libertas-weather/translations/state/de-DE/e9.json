    "type/\"\"/\"SprinklerWeatherPersistentData\"/\"SprinklerWeatherPersistentData\"/\"LocationV1\"/property/\"Description\"": {
      "Current": "sha256:25ff82ba4f7a49890f8510ab06f07959a796333fb7532df5dd2f10310bf129da",
      "Target": "Speichert den letzten gültigen Standort, der vom Libertas Hub gemeldet wurde. Dank des zwischengespeicherten Werts können Anbieteraktualisierungen fortgesetzt werden, während der Hub vorübergehend nicht verfügbar ist."
    },
    "type/\"\"/\"SprinklerWeatherPersistentData\"/\"SprinklerWeatherPersistentData\"/\"LocationV1\"/property/\"Name\"": {
